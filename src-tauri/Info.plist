<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shown in the macOS consent prompt when a Mac source first touches
	     Notes/Calendar through AppleEvents. Merged into the bundle's
	     Info.plist by Tauri at build time. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>Alchemy syncs Apple Notes and Calendar items you add as sources.</string>
	<!-- What makes the container's Documents folder show up at the iCloud
	     Drive root as "Alchemy", with the app icon, instead of staying
	     hidden inside Mobile Documents (docs/RFC-okf-live.md 5.7, stage
	     two). Inert until the build carries the matching entitlement:
	     macOS ignores a container declared here that the signature does not
	     claim, so this ships unconditionally rather than forking the
	     Info.plist for one release path. -->
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.com.thrashr888.alchemy</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>Alchemy</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>
	<!-- "Add to Alchemy" in every app's Services menu: selected text, links,
	     or Finder files become sources (handled in src/services.rs). -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Add to Alchemy</string>
			</dict>
			<key>NSMessage</key>
			<string>addToAlchemy</string>
			<key>NSPortName</key>
			<string>Alchemy</string>
			<key>NSSendTypes</key>
			<array>
				<string>NSStringPboardType</string>
				<string>NSURLPboardType</string>
				<string>NSFilenamesPboardType</string>
			</array>
			<key>NSRequiredContext</key>
			<dict/>
		</dict>
	</array>
</dict>
</plist>
